{
  "name": "rehydria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && pnpm --filter rehydria-functions typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "functions:build": "pnpm --filter rehydria-functions build",
    "emulators": "firebase emulators:start --project demo-rehydria --only firestore,auth,storage",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "emulators:persist": "firebase emulators:start --project demo-rehydria --only firestore,auth,storage --import=.emulator-data --export-on-exit",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "admin:grant": "tsx --env-file-if-exists=.env.local scripts/admin-grant.ts",
    "courses:publish": "tsx --env-file-if-exists=.env.local scripts/publish-courses.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^7.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "15.36.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
