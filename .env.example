# ─────────────────────────────────────────────────────────────────────────────
# Rehydria Technology platform: environment template
# Copy to .env.local for development. NEVER commit real values.
# Setup steps for every value: docs/FIREBASE_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for metadata, emails, CSRF origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase web app (public by design; protected by rules + App Check) ──────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise) site key
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# true = connect SDKs to the local Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# Local emulator hosts (development only; leave empty in Vercel). With the emulator, use
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-rehydria and no credentials. Then: pnpm emulators && pnpm seed
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
# Emulator only: stops the Admin SDK probing for Google Cloud metadata.
# METADATA_SERVER_DETECTION=none

# ── Firebase Admin (SERVER ONLY, never prefix with NEXT_PUBLIC_) ──────────
# From the rehydria-web service account JSON. Keep "\n" escapes in the key.
# Leave empty to use Application Default Credentials / Vercel OIDC.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Set to true instead of a key when running on Google Cloud / Vercel OIDC with ADC.
FIREBASE_ADMIN_USE_ADC=
# Session cookie lifetime in days (1–14)
SESSION_COOKIE_DAYS=7

# ── Razorpay (SERVER ONLY) ─────────────────────────────────────────────────
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend ─────────────────────────────────────────────────────────────────
# Emails are sent from Cloud Functions. In production set this as a Firebase
# secret (firebase functions:secrets:set RESEND_API_KEY). Kept here for local tools.
RESEND_API_KEY=
EMAIL_FROM="Rehydria Technology <no-reply@your-domain.example>"
EMAIL_REPLY_TO=

# ── Bunny Stream: secure course video (SERVER ONLY) ───────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_API_KEY=

# ── Certificate defaults (admin settings in /admin/settings take precedence) ─
DIRECTOR_NAME=
DIRECTOR_SIGNATURE_URL=
